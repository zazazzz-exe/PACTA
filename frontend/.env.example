# --- Mainnet Pacts (Phase B) --------------------------------------------------
# OFF until the escrow contract is security-audited AND deployed to mainnet by
# the project owner. All four must be set for mainnet Pacts to enable. These are
# PUBLIC, non-secret values (on-chain contract ids / asset SAC addresses), so
# VITE_-prefixing (bundled into the client) is intentional.
# scripts/deploy-mainnet.sh prints all four values at the end of a deploy.
VITE_MAINNET_PACTS_ENABLED=false
VITE_MAINNET_ESCROW_CONTRACT_ID=      # set after the audited mainnet deploy
VITE_MAINNET_SETTLEMENT_SAC=          # mainnet USDC SAC (contract id), confirm at deploy
VITE_MAINNET_READ_SOURCE=             # a funded mainnet account for read simulation

# Soroban RPC for mainnet. There is no free, SLA-backed public mainnet RPC, so
# point this at a provider endpoint before taking real traffic. Left unset it
# falls back to a community endpoint, which is fine for a first look only.
# Not part of the enablement gate: the wallet layer does not use Soroban RPC.
VITE_MAINNET_RPC_URL=

# Indicative PHP display rates (portfolio estimates only, never used in a
# contract call). Comma-separated CODE:RATE pairs, e.g. XLM:22,USDC:56.
# Leave unset to use the built-in defaults.
VITE_PHP_RATES=
